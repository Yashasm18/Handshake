{
  "name": "handshake-video",
  "private": true,
  "type": "module",
  "description": "Handshake's demo video, thumbnails and gallery: stills from one real deal on the live site, narrated and composed with Remotion.",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "voice": "node scripts/voice.mjs",
    "render": "remotion render src/index.jsx Demo out/demo-raw.mp4 --scale=1.3333333333333333 --crf=16",
    "loudness": "ffmpeg -v error -y -i out/demo-raw.mp4 -c:v copy -af loudnorm=I=-14:TP=-1.5:LRA=11 -c:a aac -b:a 192k -ar 48000 out/demo.mp4",
    "publish": "node scripts/publish-demo.mjs",
    "studio": "remotion studio src/index.jsx"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "kokoro-js": "1.2.1",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
