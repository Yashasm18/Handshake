# Copy to .env and fill in. Never commit .env.
# The web app reads it through web/.env.local (a symlink: cd web && ln -s ../.env .env.local).

# ── PayPal (Developer Dashboard → Apps & Credentials, sandbox) ─────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Sandbox seller account (Developer Dashboard → Testing Tools → Sandbox Accounts). Payouts for guest
# demo sellers go here; sellers who sign in with PayPal are paid into their own account.
SELLER_EMAIL=

# Sign in with PayPal: enable "Log in with PayPal" on the same app, with the Return URL
# https://<host>/api/auth/paypal/callback. Sessions are signed with SESSION_SECRET (if unset, a key
# derived from PAYPAL_CLIENT_SECRET). APP_URL pins the public address used for the Return URL.
# SESSION_SECRET=
# APP_URL=https://handshake-5rkw.onrender.com
# Production: only sellers signed in with PayPal may create deals (no demo payouts).
# REQUIRE_SIGN_IN=true

# Judge mode: the "pay with PayPal's sandbox test card" button. On by default with the sandbox
# API base; set to false to hide it.
# ENABLE_TEST_CARD=true

# ── Email updates (https://resend.com → API Keys) ──────────────────────
# Without a key, emails are only logged. Until you verify a domain in Resend, it only delivers to
# the address you signed up with; EMAIL_FROM must then stay on resend.dev.
RESEND_API_KEY=
# EMAIL_FROM=Handshake <deals@your-domain.com>

# ── Channel3 (https://trychannel3.com/developers) ─────────────────────────
CHANNEL3_API_KEY=

# Kernel cloud browsers, used when a buyer pastes a listing link (optional: without it, links ask for text instead).
KERNEL_API_KEY=

# Elastic scam memory (optional: without it, checks run without memory). From your Elasticsearch
# project's connection details. ELASTIC_INDEX defaults to handshake-scams.
ELASTIC_URL=
ELASTIC_API_KEY=

# ── OpenRouter (https://openrouter.ai/keys) ──────────────────────────────
OPENROUTER_API_KEY=

# ── Deadlines ────────────────────────────────────────────────────────────
# 1 = real days. Lower it to try timers quickly (0.0007 ≈ one day per minute).
TIMER_SCALE=1

# Shared with the Render Workflow (see workflows/). Leave empty locally: without it, opening a
# deal enforces any deadline that has passed. On Render it's generated in the Blueprint.
# TIMERS_SECRET=

# Where deals are stored. Defaults to web/.data locally; Render uses a persistent disk.
# DATA_DIR=
